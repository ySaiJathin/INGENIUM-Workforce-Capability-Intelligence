# Copy this file to .env and fill in real values. Never commit .env.
# See total_buildplan.md §6/§7 and CLAUDE.md for what each value is used for.

# Mistral API (Tasks 4/6/10) — resume extraction, adaptive question generation,
# question explanation, optional open-ended answer evaluation, learning-path rationale.
MISTRAL_API_KEY=your_mistral_api_key_here

# PostgreSQL connection (Task 2) — PostgreSQL only, no second database (CLAUDE.md standing rule).
# Runs in Docker for local dev (see docker-compose.yml) on host port 5433 — mapped off the default
# 5432 to avoid clashing with any other Postgres container already running on this machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/competency_intelligence

# Backend server (Task 3)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Local model paths (Task 0 §7 — already present locally, do not download alternatives)
ESCO_DATA_DIR=data/raw/esco
MINILM_MODEL_DIR=models/all-MiniLM-L6-v2

# Resume upload limits (Task 4)
MAX_RESUME_UPLOAD_MB=5

# TEMPORARY MVP BRIDGE (see backend/src/api/candidates.py): when false (default), a real resume
# upload skips Mistral-based skill extraction and reuses the existing internal default candidate
# profile's data instead of extracting the real resume — a stopgap for sustained Mistral quota
# exhaustion. Set to true once Mistral is reliably available again to restore real extraction.
RESUME_UPLOAD_MISTRAL_EXTRACTION=false
